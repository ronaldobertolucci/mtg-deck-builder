# Database
DATASOURCE_URL=jdbc:postgresql://<host>:5432/mydb
DATASOURCE_USERNAME=user
DATASOURCE_PASSWORD=password

# JWT
API_SECURITY_TOKEN_SECRET=your-secret-key-here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Email reset
APP_EMAIL_FROM=noreply@seudominio.com
APP_FRONTEND_URL=frontend-url
APP_NAME=your-frontend-application-name
APP_EMAIL_VERIFICATION_EXPIRY_HOURS=24
MAIL_HOST=your-smtp
MAIL_PORT=<port>
MAIL_USERNAME=username@example.com
MAIL_PASSWORD=password
MAIL_AUTH=true/false
MAIL_STARTTLS=true/false
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_CLEANUP_CRON=0 0 2 * * ?

# Card Manager: em dev, o padrao e http://localhost:8000; configure a URL em prod.
# Override opcional do caminho; deve conter {oracleId}. O cliente envia lang=en.
CARD_MANAGER_URL=
CARD_MANAGER_ORACLE_DETAILS_PATH=/cards/{oracleId}
